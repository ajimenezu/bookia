# =============================================================================
# LOCAL DEVELOPMENT env — copy to `.env`
# =============================================================================
#   cp .env.example .env
#
# Use `.env` (NOT `.env.local`) for local dev: Prisma CLI auto-loads `.env`, and
# Next.js loads it too — so one file drives both the app and migrations, with no
# split-brain where the app hits one DB and Prisma another.
#
# IMPORTANT — production isolation:
#   • Production credentials live ONLY in Vercel. Never put prod values on disk.
#   • Do NOT keep a `.env.local` with prod creds — in Next it OVERRIDES `.env`,
#     which would silently point the running app at production. Delete it.
#   • The prod guard (scripts/check-not-prod.js) blocks db:migrate/reset/seed
#     against any non-local host, but the rule above keeps the *app* local too.
#
# Setup:
#   1. npm run supabase:start         # boots local Postgres + Auth + Studio (Docker)
#   2. cp .env.example .env
#   3. npm run supabase:status        # confirm the keys below match your machine
#   4. npm run db:reset               # schema (Prisma) + JWT hook + seed
# Full walkthrough: docs/LOCAL_DEV.md
# =============================================================================

# --- Database (Prisma reads DIRECT_URL) --------------------------------------
# Local Supabase Postgres. db:migrate / db:reset / db:seed only run when this
# host is localhost / 127.0.0.1 (enforced by scripts/check-not-prod.js).
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase API -------------------------------------------------------------
# Values from `npm run supabase:status`. This CLI version issues the new
# publishable/secret key format; the app uses the publishable key as its anon
# key and the secret key as the service-role key.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_pu...""
SUPABASE_SERVICE_ROLE_KEY="sb_secret..."

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cron / API ---------------------------------------------------------------
CRON_SECRET="local-dev-secret"

# --- Optional integrations (leave blank locally unless testing them) ----------
# Auth/transactional emails are captured by the local Mailpit UI
# (http://127.0.0.1:54324) instead of actually being sent.
RESEND_API_KEY=""
EMAIL_FROM_DOMAIN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# WhatsApp reminders — leave blank locally (sending is a no-op without these).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_REMINDER_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG=""
